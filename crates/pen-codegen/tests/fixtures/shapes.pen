{
  "version": "2.22",
  "children": [
    {
      "type": "frame", "id": "canvas", "name": "Shapes", "x": 0, "y": 0, "width": 420, "height": 260,
      "layout": "none", "fill": "#F8FAFC", "clip": true,
      "children": [
        { "type": "rectangle", "id": "grad", "name": "Gradient", "x": 20, "y": 20, "width": 120, "height": 80,
          "cornerRadius": [16, 0, 16, 0],
          "fill": { "type": "gradient", "gradientType": "linear", "rotation": 270,
            "colors": [ { "color": "#F97316", "position": 0 }, { "color": "#DB2777", "position": 1 } ] } },
        { "type": "ellipse", "id": "circle", "name": "Circle", "x": 160, "y": 20, "width": 80, "height": 80,
          "fill": { "type": "gradient", "gradientType": "radial",
            "colors": [ { "color": "#FDE68A", "position": 0 }, { "color": "#F59E0B", "position": 1 } ] },
          "stroke": "#92400E", "strokeWidth": 4, "strokeAlignment": "outer" },
        { "type": "ellipse", "id": "arc", "name": "Arc", "x": 260, "y": 20, "width": 80, "height": 80,
          "innerRadius": 0.6, "sweepAngle": 270, "fill": "#10B981" },
        { "type": "polygon", "id": "tri", "name": "Triangle", "x": 20, "y": 130, "width": 80, "height": 80,
          "polygonCount": 3, "fill": "#6366F1", "stroke": "#312E81", "strokeWidth": 3, "strokeAlignment": "inner" },
        { "type": "path", "id": "wave", "name": "Wave", "x": 120, "y": 140, "width": 140, "height": 60,
          "geometry": "M0 30 C 35 0, 70 60, 140 30", "stroke": "#0EA5E9", "strokeWidth": 4,
          "strokeLinecap": "round" },
        { "type": "rectangle", "id": "photo", "name": "Photo", "x": 290, "y": 130, "width": 100, "height": 100,
          "cornerRadius": 12, "fill": { "type": "image", "url": "checker.png", "mode": "cover" },
          "effect": [ { "type": "shadow", "offset": { "x": 0, "y": 2 }, "blur": 6, "color": "#00000040" } ] },
        { "type": "rectangle", "id": "tilt", "name": "Tilted", "x": 360, "y": 40, "width": 40, "height": 40,
          "rotation": 30, "fill": "#A855F7", "opacity": 0.8,
          "strokeWidth": { "bottom": 3 }, "stroke": "#581C87" }
      ]
    }
  ]
}
